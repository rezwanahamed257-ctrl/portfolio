# ═══════════════════════════════════════════════════
# .env.example — Copy this file and name it ".env"
# Then fill in your real values.
# NEVER commit your .env file to GitHub!
# ═══════════════════════════════════════════════════

# Your Gmail address (the one that SENDS the email)
EMAIL_USER=your-gmail@gmail.com

# Gmail App Password (NOT your regular password)
# How to get it: Google Account → Security → 2-Step Verification → App Passwords
# Create one for "Mail" and copy the 16-character code here
EMAIL_PASS=your-16-char-app-password

# The email address that RECEIVES messages (usually same as EMAIL_USER)
EMAIL_TO=your-inbox@gmail.com

# Your frontend URL (for CORS security)
# Example: https://yourusername.github.io
FRONTEND_URL=https://yourusername.github.io

# Port (Render sets this automatically, leave as 3000 for local)
PORT=3000
